rules_version = '2';

// All data access in this app goes through the Next.js server using the Firebase
// Admin SDK, which bypasses these rules entirely. The browser never reads or
// writes Firestore directly, so we deny ALL client access as defense-in-depth:
// even a leaked client config grants zero data access, and the "don't peek at
// others' picks before kickoff" rule is enforced by the server choosing what to
// return (others' predictions are only sent for matches that are final).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
