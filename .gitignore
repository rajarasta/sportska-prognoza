# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase Admin service-account key (NEVER commit)
*firebase-adminsdk*.json
serviceAccount*.json

# allow committing an env template
!.env.example

# design handoff (kept locally as reference, not shipped)
/design/

# live-score watcher inbox (scraped snapshots + processed/failed archives — local only)
/live-inbox/*
!/live-inbox/.gitkeep

# Stray Python virtualenv accidentally created in the repo root (not part of the app)
/bin/
/lib/
/lib64
/include/
/pyvenv.cfg
