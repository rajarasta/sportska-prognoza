# ── Firebase Web SDK (public client config; safe to expose / commit) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Server-side admin credentials ──
# Local ONLY: absolute path to the Firebase Admin service-account JSON.
# In production (App Hosting) leave this UNSET — Application Default Credentials
# (the backend's compute service account) are used automatically.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Session cookies (next-firebase-auth-edge) ──
# Comma-separated rotating secret keys. Generate one: openssl rand -base64 32
AUTH_COOKIE_SIGNATURE_KEYS=
AUTH_COOKIE_NAME=__session

# ── League ──
# Comma-separated emails allowed to perform admin actions (enter results).
LEAGUE_ADMIN_EMAILS=

# ── Results crawler ──
# Which results source to use: "mock" (default, no external calls) or "thesportsdb".
RESULTS_PROVIDER=mock
# API key for the chosen provider. TheSportsDB works with the free test key "123".
RESULTS_API_KEY=
# For RESULTS_PROVIDER=mock — JSON of match id → [home, away] goals.
# Example: MOCK_RESULTS={"t001":[2,1],"t002":[0,0],"t003":[3,2]}
MOCK_RESULTS=
# Shared secret that protects POST/GET /api/cron/crawl-results. Generate one:
# openssl rand -base64 32   (the route fails closed if this is unset)
CRON_SECRET=

# ── Local emulators (optional) ──
# Set to "true" to point the app at the Firebase emulator suite.
NEXT_PUBLIC_USE_EMULATORS=
